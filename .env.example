# Everything is optional: without Supabase the app runs in local-only mode
# (data in this browser's IndexedDB, no sign-in).

# Supabase (sync, auth, Realtime, Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Vercel Cron auth (Vercel sends "Authorization: Bearer $CRON_SECRET")
CRON_SECRET=

# Weekly email digest (Resend)
RESEND_API_KEY=
DIGEST_FROM=Paisa OS <digest@yourdomain.com>
